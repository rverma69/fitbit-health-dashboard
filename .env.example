# ==============================================================================
# STATIX - Google Health & Fitbit Biometric Dashboard Environment Configuration
# ==============================================================================

# Port to run the server on (default: 3000)
PORT=3000

# Google Health / Fitbit OAuth Credentials
# Obtain these from Google Cloud Console (APIs & Services > Credentials)
FITBIT_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
FITBIT_CLIENT_SECRET=your_google_oauth_client_secret

# OAuth Redirect URI (must match Google Cloud Console authorized redirect URIs)
# Local development:
FITBIT_REDIRECT_URI=http://localhost:3000/auth/callback
# Production (e.g. Render):
# FITBIT_REDIRECT_URI=https://your-app-name.onrender.com/auth/callback

# Google Gemini AI API Key (Optional: powers the AI Health & Circadian Sleep Coach)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
